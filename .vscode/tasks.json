{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "ArchiForge: Bootstrap Python .venv & Install Dependencies",
      "type": "shell",
      "command": "python3 -m venv .venv && .venv/bin/pip install --upgrade pip && .venv/bin/pip install -r requirements.txt",
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "ArchiForge: Run Contract & Smoke Tests (pytest)",
      "type": "shell",
      "command": "pytest -v",
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "ArchiForge: Start Local Stack (Docker Compose)",
      "type": "shell",
      "command": "docker compose up --build",
      "isBackground": true
    }
  ]
}