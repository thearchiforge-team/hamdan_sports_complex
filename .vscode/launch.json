{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "ArchiForge: Debug Hamdan Sports Complex Unified Arena & Academy Platform FastAPI (Uvicorn)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "src.main:app",
        "--reload",
        "--host",
        "0.0.0.0",
        "--port",
        "8000"
      ],
      "env": {
        "PYTHONPATH": "${workspaceFolder}",
        "APP_ENV": "development"
      },
      "jinja": true,
      "justMyCode": true
    },
    {
      "name": "ArchiForge: Run Contract & Smoke Tests (Pytest)",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": [
        "-v",
        "tests/"
      ],
      "env": {
        "PYTHONPATH": "${workspaceFolder}"
      }
    }
  ]
}